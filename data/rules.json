[
  {
    "id": "rule-pbuh",
    "label": "PBUH -> Peace be upon him",
    "type": "dictionary",
    "pattern": "PBUH",
    "replacement": "peace be upon him",
    "match_whole_word": true,
    "case_sensitive": false,
    "enabled": true
  },
  {
